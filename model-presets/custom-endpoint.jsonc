{
  "$schema": "model-preset/v1",
  "name": "custom-endpoint",
  "description": "Template for user-configured custom OpenAI-compatible router/endpoint. Meowstro follows the session model.",
  "agents": {
    "whisker": {
      "model": "custom:fast-coder",
      "variant": "low"
    },
    "sphinx": {
      "model": "custom:primary-model",
      "variant": "high"
    },
    "calico": {
      "model": "custom:fast-coder",
      "variant": "medium"
    },
    "tinker": {
      "model": "custom:fast-coder",
      "variant": "high",
      "temperature": 0.2
    },
    "tuxeshadow": {
      "model": "custom:primary-model",
      "variant": "high"
    },
    "clowder": {
      "model": [
        "custom:primary-model",
        "custom:fast-coder"
      ]
    }
  }
}
