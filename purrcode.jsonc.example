{
  "$schema": "https://raw.githubusercontent.com/latifangren/purrcode-ai/main/docs/schema/purrcode.schema.json",

  // Preset mode perilaku: carrier (strict), tabby (default), oyen (god)
  "preset": "tabby",

  // Preset model inferensi per agen: custom-endpoint, free, local, premium
  "model_preset": "custom-endpoint",

  // Konfigurasi endpoint provider (bisa local proxy, LAN router, atau cloud)
  "providers": {
    // Contoh 1: Router/Proxy lokal (seperti Magpie atau OmniRoute)
    "magpie": {
      "api": "openai-completions",
      "base_url": "http://127.0.0.1:3425/v1",
      "api_key": "magpie",
      "models": {
        "magpie/antigravity/gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash Tiered",
          "context_window": 1048576,
          "max_tokens": 65536,
          "reasoning": true
        },
        "magpie/group/custom-coding-free": {
          "name": "Custom Coding Free Group",
          "context_window": 1048576,
          "max_tokens": 65536,
          "reasoning": true
        },
        "magpie/codex/gpt-6-luna": {
          "name": "Codex Luna High",
          "context_window": 200000,
          "max_tokens": 64000,
          "reasoning": true
        }
      }
    },

    // Contoh 2: Ollama lokal (offline)
    "ollama": {
      "api": "openai-completions",
      "base_url": "http://127.0.0.1:11434/v1",
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B",
          "context_window": 131072,
          "max_tokens": 8192,
          "reasoning": false
        }
      }
    },

    // Contoh 3: OpenRouter / Cloud API
    "openrouter": {
      "api": "openai-completions",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key": "${OPENROUTER_API_KEY}",
      "models": {
        "meta-llama/llama-3.3-70b-instruct:free": {
          "name": "Llama 3.3 70B Free",
          "context_window": 131072,
          "max_tokens": 8192
        }
      }
    }
  },

  // Konfigurasi server MCP eksternal
  "mcp_servers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "codegraph": {
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    }
  }
}
