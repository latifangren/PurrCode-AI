{
  "$schema": "./docs/schema/purrcode.schema.json",

  // Behavior mode preset: carrier (strict), tabby (default), oyen (god)
  "preset": "tabby",

  // Subagent inference model preset: custom-endpoint, free, local, premium
  "model_preset": "custom-endpoint",

  // Provider endpoint configurations (zero hardcoded endpoints/keys; set via env or ~/.purrcode/credentials)
  "providers": {
    "custom": {
      "api": "openai-completions",
      "base_url": "${CUSTOM_LLM_BASE_URL}",
      "api_key": "${CUSTOM_LLM_API_KEY}",
      "models": {
        "primary-model": {
          "name": "Primary Orchestrator Model",
          "context_window": 200000,
          "max_tokens": 64000,
          "reasoning": true
        },
        "fast-coder": {
          "name": "Fast Subagent Coding Model",
          "context_window": 131072,
          "max_tokens": 32768,
          "reasoning": true
        }
      }
    },
    "ollama": {
      "api": "openai-completions",
      "base_url": "${OLLAMA_BASE_URL}",
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B",
          "context_window": 131072,
          "max_tokens": 8192,
          "reasoning": false
        }
      }
    },
    "openrouter": {
      "api": "openai-completions",
      "base_url": "${OPENROUTER_BASE_URL}",
      "api_key": "${OPENROUTER_API_KEY}",
      "models": {
        "meta-llama/llama-3.3-70b-instruct:free": {
          "name": "Llama 3.3 70B Free",
          "context_window": 131072,
          "max_tokens": 8192
        }
      }
    },
    // Dev-testing provider: the user's own Magpie gateway on their PC,
    // exposed via Cloudflare tunnel. Key ONLY from env ${MAGPIE_API_KEY}
    // (or ~/.purrcode/credentials) — never write it into this file.
    // Model preset for it: model-presets/magpie.jsonc.
    // NOTE (2026-11-12, verified live; corrected 2026-11-12): this
    // gateway's Cloudflare WAF rejects requests with NO User-Agent header
    // at all (HTTP 403, error 1010 \"browser signature\") — reqwest 0.12
    // Client::new() sends no UA header, so the old binary was blocked,
    // NOT because of a literal \"reqwest/*\" value. The honest PurrCode
    // default UA passes (proven live: a request with no \"user_agent\" set
    // succeeded). So this provider sets NO user_agent; the default is
    // used. If another gateway is stricter, set \"user_agent\" here (a
    // browser UA), or a per-request \"User-Agent\" in \"headers\" (which
    // wins over both).
    "magpie": {
      "api": "openai-completions",
      "base_url": "https://magpie.raevtar.dev/v1",
      "api_key": "${MAGPIE_API_KEY}",
      "models": {
        "antigravity/gemini-3.8-flash-tiered": {
          "name": "Gemini 3.8 Flash (Tiered) via Antigravity",
          "context_window": 1048576,
          "max_tokens": 65536,
          "reasoning": true
        }
      }
    }
  },

  // External MCP servers
  "mcp_servers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "codegraph": {
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    }
  },

  // Telegram gateway (v0.2, ADR-013). Run with `purrcode-ai gateway`.
  // The bot token comes from ~/.purrcode/credentials (0600) or the
  // environment as ${TELEGRAM_BOT_TOKEN} — never put a literal token here.
  // allow_from is FAIL-CLOSED: an empty list authorizes NOBODY.
  // Group chats must be listed explicitly AND the bot must be @-mentioned.
  "telegram": {
    "bot_token": "${TELEGRAM_BOT_TOKEN}",
    "allow_from": [
      // 123456789
    ],
    "api_base": "https://api.telegram.org",
    "approval_timeout_secs": 120,
    "poll_timeout_secs": 30
  },
  // Cron daemon settings (v0.3 F19, ADR-014). Absent = cron disabled.
  // Job definitions live in a dedicated store, NOT here:
  // ~/.purrcode/cron/jobs.jsonc (managed via `purrcode-ai cron`).
  "cron": {
    "enabled": true,
    "tick_secs": 60
  }
}
